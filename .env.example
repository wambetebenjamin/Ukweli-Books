# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://ukwelibooks.co.ke

# ---- Downloads (HMAC signed links, 7-day expiry) ----
UKWELI_TOKEN_SECRET=change-me-in-production

# ---- Auth (NextAuth v4) ----
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
# Google OAuth (optional — sign-in falls back to demo email OTP without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Storage (Vercel KV / Upstash — optional; in-memory fallback in dev) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 7-day signed URLs for book PDFs in production
BLOB_READ_WRITE_TOKEN=

# ---- Payments ----
# M-Pesa Daraja (STK push)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Stripe (cards + recurring subscriptions) — optional alternative
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Delivery ----
SENDGRID_API_KEY=            # email delivery of download links
WHATSAPP_TOKEN=              # WhatsApp Cloud API
WHATSAPP_PHONE_ID=

# ---- SMTP (enables real email OTP instead of demo provider) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
